# Copy to .env.development.local for local dev (Neon "dev" branch).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/card_app
DATABASE_URL_UNPOOLED=postgres://postgres:postgres@localhost:5432/card_app

# Minimum log level: debug | info | warn | error. Default: debug in dev, info elsewhere.
LOG_LEVEL=debug

# Temporary test login: shows a user switcher. Local dev only; never set in Vercel.
TEST_LOGIN=1

# Local Chroma vector store: run `npm run chroma` (persists to ./chroma-data).
CHROMA_HOST=localhost
CHROMA_PORT=8000
